# C++ HTTPS server. Set this origin to the LAN address covered by your certificate.
DUALVIEW_HOST=0.0.0.0
DUALVIEW_PORT=8443
DUALVIEW_PUBLIC_ORIGIN=https://192.168.1.42:8443
DUALVIEW_TLS=true
DUALVIEW_TLS_CERT=certs/dualview-lab.pem
DUALVIEW_TLS_KEY=certs/dualview-lab-key.pem
DUALVIEW_FRONTEND_DIR=frontend/dist

# QR presentation and pairing authorization are independent.
DUALVIEW_SHOW_QR_CODE=true
DUALVIEW_PAIRING_REQUIRED=true

# Native camera capture.
DUALVIEW_CAMERA_ENABLED=true
DUALVIEW_CAMERA_INDEX=0
DUALVIEW_CALIBRATION_FILE=data/calibration/native.yml

# Inference provider: cpu (portable) or coreml (macOS).
# Core ML can partition a model between Apple accelerators and CPU.
# Fallback applies to unavailable providers; model-loading errors remain visible.
DUALVIEW_INFERENCE_ENABLED=true
DUALVIEW_INFERENCE_PROVIDER=coreml
DUALVIEW_INFERENCE_ALLOW_CPU_FALLBACK=false
DUALVIEW_INFERENCE_MAX_FPS=15
DUALVIEW_MODELS_DIR=models/onnx

# Docker Compose uses CPU and no host camera by default; native settings above
# remain unchanged. For Linux camera access, use compose.camera.yaml.
# DUALVIEW_DOCKER_INFERENCE_PROVIDER=cpu
# DUALVIEW_DOCKER_CAMERA_ENABLED=false

# Per-camera VP8 preview target bitrate in bits/s (500000–20000000).
# Higher values preserve detail at the cost of LAN bandwidth and encoding work.
DUALVIEW_PREVIEW_BITRATE=6000000

# Maximum receive-time difference accepted when pairing laptop and phone frames.
# Increasing this can mismatch moving hands; calibration always requires <=80 ms.
# Independent of this budget, tracking rejects a pair older than 250 ms, and
# preview/calibration treat a frame older than 650 ms as not live.
DUALVIEW_MAX_PAIR_ERROR_MS=80

# Structured tracking diagnostics; '-' writes to stderr for container logs.
# Local files rotate at 2 MB, retaining three backups. No camera images are logged.
DUALVIEW_TRACKING_LOG=logs/dualview-native.jsonl
# Rendered metal state, sampled up to 10 times per second with bounded rotation.
DUALVIEW_METAL_LOG=logs/dualview-metal.jsonl

# Landmark filter that produces the published pose.
#   alpha       Position-only blend. The supported default.
#   alpha_beta  The same blend with its velocity feedforward connected.
#   kalman      EXPERIMENTAL constant-velocity filter with anisotropic noise.
# Only "alpha" is exercised on physical hardware; the others are validated
# against synthetic geometry only. See docs/tracking-filters.md.
DUALVIEW_TRACKING_FILTER=alpha
# Run the non-published estimators alongside the selected one and record their
# divergence in telemetry and the tracking log. Costs extra work per frame and
# never changes interaction output.
DUALVIEW_TRACKING_FILTER_COMPARE=false
# Tuning for the non-default estimators; defaults come from the synthetic sweep.
# DUALVIEW_TRACKING_FILTER_ALPHA=0.65
# DUALVIEW_TRACKING_FILTER_BETA=0.35
# DUALVIEW_TRACKING_KALMAN_ACCEL=4.0
# DUALVIEW_TRACKING_KALMAN_NOISE_PX=1.5

# Per-frame landmark recording for offline estimator comparison. Empty disables
# it. Unlike DUALVIEW_TRACKING_LOG (a ~1 Hz status sampler with no landmarks),
# this records every processed pair, so filter behaviour between samples is
# visible. Files are large; recording stops after the second limit below.
# Analyse with: node scripts/analyze-capture.mjs <file>
DUALVIEW_TRACKING_CAPTURE=
DUALVIEW_TRACKING_CAPTURE_SECONDS=120

# Optional measured phone delivery offset. Zero keeps receive-time pairing.
# This is not sensor synchronization; only set after a controlled timing test.
DUALVIEW_PHONE_TIME_OFFSET_MS=0
